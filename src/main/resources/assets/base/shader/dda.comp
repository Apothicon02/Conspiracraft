        imageStore(Image2D[nonuniformEXT(pushUbo.writeTex.w)], coords, vec4(reflectColor.rgb, maxFrensel > 0.f ? maxFrensel : 3.f));
        //color.rgb = desaturate(color.rgb, 1-clamp(blockLighting.a*globalUbo.skylightMul.w, fogginess, 1));
        float maxLightshaft = max(lightshaft.r, max(lightshaft.g, lightshaft.b));
        outNormal.a = emissive || celestial ? 1 : mix(min(1, outNormal.a+pow(maxLightshaft, 0.2f)), 1, max(clamp(depth-0.9f, 0, 0.001f)*1000, tintAmt));
        //    color = vec4(mix(vec3(0, 1, 0), vec3(1, 0, 0), clamp(steps/200.f, 0, 1)), 1);
        //    outNormal.a = 1;
        if (globalUbo.renderToggles.x == 2 && maxFogginess > 0.25f) {
            if (!isGodray) { color.rgb = mix(color.rgb, vec3(0.045f, 0.045f, 0.067f), 0.5f*maxFogginess*globalUbo.skylightMul.w); } else { color.rgb += vec3(0.1f, 0.1f, 0.05f)*maxFogginess*globalUbo.skylightMul.w; }
        }
        float colMax = max(color.r, max(color.g, color.b));
        if (!emissive && colMax > 1) {
            color.rgb /= colMax;
        }
        color.rgb+=lightshaft*0.75f;
        color.rgb = max(vec3(0), color.rgb);
        vec4 bloom = vec4(0);
        if (emissive) {
            bloom.rgb = color.rgb;
        } else if (isSky) {
            bloom.rgb = color.rgb*clamp(dot(ogDir, normalize(source)), 0, 1);
        }
        imageStore(Image2D[nonuniformEXT(pushUbo.tex2.z)], coords, bloom);
        vec4 sunOnly = getLightingColor(celestialSource, primaryLightPos, vec4(0, 0, 0, blockLighting.w), false, 0, false)*0.5f;
        float blocklightBrightness = max(0, max(blockLighting.r-sunOnly.r, max(blockLighting.g-sunOnly.g, blockLighting.b-sunOnly.b)));
        imageStore(Image2D[nonuniformEXT(pushUbo.writeTex.x)], coords, vec4(color.rgb, (celestial || isSky) ? 1 : (shadowFactor < 1 ? min(1, mix(clamp(shadowFactor+maxLightshaft, 0.02f, 0.99f), 1, max(max(clouds, primaryFogginess), blocklightBrightness))) : 3)));
        imageStore(DepthImage2D[nonuniformEXT(pushUbo.writeTex.y)], coords, vec4(depth, 0, 0, 0));
        imageStore(Image2D[nonuniformEXT(pushUbo.writeTex.z)], coords, outNormal);
    }
}