float minLight = 0.f;
vec4 getLightingColor(bool celestialSource, vec3 lightPos, vec4 lighting, bool isSky, float fogginess, bool negateSun) {
    vec3 maxedSun = globalUbo.sun;
    maxedSun.y = max(0, maxedSun.y);
    float sunHeight = globalUbo.fogginess < 0 ? 1 : abs(dot(normalize(maxedSun - lightPos), vec3(0, 1, 0)));
    vec3 minnedSun = globalUbo.sun;
    minnedSun.y = min(0, minnedSun.y);
    float sunDepth = globalUbo.fogginess < 0 ? 1 : abs(dot(normalize(minnedSun - lightPos), vec3(0, 1, 0)));
    float nightness = (clamp(sunDepth, 0.1f, 0.2f)-0.1f)*10;
    sunColor = mix(globalUbo.atmosphere.rgb, globalUbo.nightAtmosphere.rgb, nightness);
    vec3 horizonColor = mix(mix(globalUbo.sunsetAtmosphere.rgb, globalUbo.deepSunsetAtmosphere.rgb, min(sunDepth, 0.1f)*10), vec3(1), min(max(max(0.f, sunDepth-0.5f), sunHeight), 0.1f)*10);
    float whiteness = (isSky ? (1.f-clamp(((lightPos.y-ogPos.y)/512)-0.25f, 0, 1)) : 1.f)-(0.7f*nightness);
    sunColor = mix(sunColor, horizonColor, whiteness);

    sunColor=sunColor*globalUbo.skylightMul.rgb*mix(lighting.a, 1.f, (max(sqrt(fogginess), 0.5f)-0.5f)*2);//mix(sunColor*globalUbo.skylightMul.rgb, sunColor*mix(lighting.a, 1.f, (max(sqrt(fogginess), 0.5f)-0.5f)*2), 0.5f);
    //sunColor*=max(vec3(0.45f, 0.45f, 0.55f), globalUbo.skylightMul.rgb);
    //sunColor *= hsv2rgb(mix(rgb2hsv(sunColor), rgb2hsv(globalUbo.skylightMul.rgb), vec3(1.f, 0.f, 0.f)));
    if (!isSky && !celestialSource) {
        sunColor = mix(globalUbo.skylightMul.rgb*lighting.a, sunColor, fogginess);
    }
    sunColor = mix(sunColor, vec3(0), fogginess*(1-globalUbo.skylightMul.w)*min(1, 0.634f+(1-whiteness)));
    //    if (!isSky && globalUbo.skylight.w >= 1.f) {
    //        sunColor*=min(sunBrightnessMul, sunBrightnessMul <= 1.f ? 1.f : max(1.f, sunBrightnessMul-fogginess));
    //    }
    float thickness = 1;//sunHeight < 0 ? gradient(lightPos.y, 128, 512-max(0, sunHeight*512), 1+(sunHeight/2), 1)-mix(0.33f, 0, clamp(sunHeight, 0, 1)) : 1;
    vec4 color = vec4(max(lighting.rgb, max(vec3(mix(minLight, 0.f, fogginess)), sunColor*thickness*globalUbo.skylight.w)), thickness);
    return isSky ? color*gradient(lightPos.y, 72, 320, skyDensity, 1) : color;
}

vec3 unzeroVec(vec3 dir) {
    vec3 newDir = sign(dir);
    newDir = mix(vec3(1.f), newDir, step(vec3(0.0001f), abs(newDir)));
    return newDir * max(abs(dir), vec3(0.0001f));
}

