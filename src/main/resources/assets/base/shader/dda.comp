vec4 getLightSmooth(vec3 pos, vec3 norm) {
    const vec4 powFactor = vec4(0.001f);
    vec3 absNorm = abs(norm);
    vec3 fractPos = fract(pos);
    vec4 baseLight = getLight(pos);
    if (absNorm.y > absNorm.x && absNorm.y > absNorm.z) {
        float xWeight = fractPos.x > 0.5f ? fractPos.x-0.5f : 0.5f-fractPos.x;
        vec4 xLight = getLight(pos.x + (fractPos.x > 0.5f ? 1 : -1), pos.y, pos.z);
        xLight = mix(baseLight, xLight, xWeight * pow(xLight, powFactor));
        float zWeight = fractPos.z > 0.5f ? fractPos.z-0.5f : 0.5f-fractPos.z;
        vec4 zLight = getLight(pos.x, pos.y, pos.z + (fractPos.z > 0.5f ? 1 : -1));
        zLight = mix(baseLight, zLight, zWeight * pow(zLight, powFactor));
        return baseLight + (xLight - baseLight) + (zLight - baseLight);
    } else if (absNorm.z > absNorm.x && absNorm.z > absNorm.y) {
        float xWeight = fractPos.x > 0.5f ? fractPos.x-0.5f : 0.5f-fractPos.x;
        vec4 xLight = getLight(pos.x + (fractPos.x > 0.5f ? 1 : -1), pos.y, pos.z);
        xLight = mix(baseLight, xLight, xWeight * pow(xLight, powFactor));
        float yWeight = fractPos.y > 0.5f ? fractPos.y-0.5f : 0.5f-fractPos.y;
        vec4 yLight = getLight(pos.x, pos.y + (fractPos.y > 0.5f ? 1 : -1), pos.z);
        yLight = mix(baseLight, yLight, yWeight * pow(yLight, powFactor));
        return baseLight + (xLight - baseLight) + (yLight - baseLight);
    } else {
        float yWeight = fractPos.y > 0.5f ? fractPos.y-0.5f : 0.5f-fractPos.y;
        vec4 yLight = getLight(pos.x, pos.y + (fractPos.y > 0.5f ? 1 : -1), pos.z);
        yLight = mix(baseLight, yLight, yWeight * pow(yLight, powFactor));
        float zWeight = fractPos.z > 0.5f ? fractPos.z-0.5f : 0.5f-fractPos.z;
        vec4 zLight = getLight(pos.x, pos.y, pos.z + (fractPos.z > 0.5f ? 1 : -1));
        zLight = mix(baseLight, zLight, zWeight * pow(zLight, powFactor));
        return baseLight + (yLight - baseLight) + (zLight - baseLight);
    }
    return baseLight;
}

ChunkStruct chunk = ChunkStruct(0, 0, 0, 0, 0, 0, 0);
int blockValuesPerInt = 0;
int chunkBufLength = chunkBuf[nonuniformEXT(pushUbo.chunks)].data.length();
void updateChunkData(ivec3 chunkPos) {
    int condensedChunkPos = (((chunkPos.x*sizeChunks)+chunkPos.z)*heightChunks)+chunkPos.y;
    if (condensedChunkPos >= 0 && condensedChunkPos < chunkBufLength) {
        chunk = chunkBuf[nonuniformEXT(pushUbo.chunks)].data[condensedChunkPos];
        blockValuesPerInt = chunk.bitsPerValue <= 0 ? 0 : 32 / chunk.bitsPerValue;
    }
}
void updateChunkData(int x, int y, int z) {
    updateChunkData(ivec3(x, y, z) >> 4);
}
int voxelBufLength = intBuf[nonuniformEXT(pushUbo.voxels)].data.length();
int getBlockData(int x, int y, int z) {
    if (chunk.bitsPerValue < 1) {return chunk.valueMask;}
    //if (blockValuesPerInt <= 0) {return 0;}
    ivec3 localPos = ivec3(x, y, z) & ivec3(15);
    int condensedLocalPos = packLocalPos(localPos);//((((localPos.x*chunkSize)+localPos.z)*chunkSize)+localPos.y);
    int intIndex = condensedLocalPos/blockValuesPerInt;
    int bitIndex = (condensedLocalPos - intIndex * blockValuesPerInt) * chunk.bitsPerValue;

    int index = chunk.pointer+chunk.paletteSize+intIndex;
    //if (index < 0 || index >= voxelBufLength) return 0;

    int key = chunk.pointer+((intBuf[nonuniformEXT(pushUbo.voxels)].data[index] >> bitIndex) & chunk.valueMask);
    //if (key < 0 || key >= voxelBufLength) return 0;
    return intBuf[nonuniformEXT(pushUbo.voxels)].data[key];
}
ivec2 getBlock(int x, int y, int z) {
    int blockData = getBlockData(x, y, z);
    int type = (blockData >> 16) & 0xFFFF;
    return ivec2(type, min(16, blockData & 0xFFFF));
}
ivec2 getBlock(vec3 pos) {
    return getBlock(int(pos.x), int(pos.y), int(pos.z));
}

