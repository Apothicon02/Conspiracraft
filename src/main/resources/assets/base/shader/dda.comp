    int type = (blockData >> 16) & 0xFFFF;
    ivec2 block = ivec2(type, min(16, blockData & 0xFFFF));
    ivec3 voxelPos = ivec3(fract(vec3(x, y, z))*blockSize);
    return sampleAtlas(voxelPos.x, voxelPos.y, voxelPos.z, block.x, block.y);
