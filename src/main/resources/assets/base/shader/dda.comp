    bool doReflections = bool(int((coords.x/localSize)*oddMul) % 2 == 1); //every other group
    ivec2 ogCoords = clamp(coords, ivec2(0), globalUbo.res-ivec2(1));
    if (isChecker != doReflections) {
        int pairBase = (coords.x / (2*localSize)) * (2*localSize);
        coords.x = 2*pairBase + 2*localSize - 1 - coords.x;
    }
    if (!(coords.x >= 0 && coords.x < res.x && coords.y >= 0 && coords.y < res.y)) {
        imageStore(Image2D[nonuniformEXT(pushUbo.writeTex.x)], ogCoords, vec4(0));
