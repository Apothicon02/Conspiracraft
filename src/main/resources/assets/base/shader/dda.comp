        vec4 outNormal = vec4(0);
        vec4 color = dda(false);
        MaterialStruct material = MaterialStruct(vec4(0), vec4(0, 0, 1, 0), vec4(0));
        float materialBrightness = 0.f;
        float reflectivity = 0;//(tint.a < 1 || block.x == 74 || block.x == 81) ? 1.f : ((block.x == 57 || block.x == 59)  ? 0.2f : ((block.x == 56 || block.x == 60 || block.x == 61) ? 0.75f : ((block.x == 79 || block.x == 80 || block.x == 94 || block.x == 86 || block.x == 87 || block.x == 88 || block.x == 64 || block.x == 84 || block.x == 83 || block.x == 90) ? 0.5f : 0.f)));
        vec3 source = globalUbo.fogginess <= 0 ? globalUbo.skylight.xyz : vec3(globalUbo.skylight.x, globalUbo.skylight.y > 0 ? max(globalUbo.skylight.y, shadowPos.y + 9) : globalUbo.skylight.y, globalUbo.skylight.z);
