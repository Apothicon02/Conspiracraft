    int localIdx = group % groupsPerTile;
    int tilesPerRow = (((res.x + localSizeSub1) / localSize) + swizzle - 1) / swizzle;
    ivec2 coords = ivec2(((tile % tilesPerRow) * swizzle) + (localIdx % swizzle), (localIdx / swizzle)) * localSize + ivec2(gl_LocalInvocationID.xy);
