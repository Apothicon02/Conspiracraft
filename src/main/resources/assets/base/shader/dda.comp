vec4 sampleAtlas(int x, int y, int z, int blockType, int blockSubtype) {
    return texelFetch(Sampler3D[nonuniformEXT(pushUbo.atlas)], ivec3(x+(blockType*blockSize), ((abs(y-blockSize)-1)*blockSize)+z, blockSubtype), 0);
}
vec4 sampleAtlasTiled(int x, int y, int z, int blockType, int blockSubtype) {
    ivec3 pos = ivec3(x, y, z);
    if (pos.x < 0) {pos.x+=blockSize;} else if (pos.x >= blockSize) {pos.x-=blockSize;}
    if (pos.y < 0) {pos.y+=blockSize;} else if (pos.y >= blockSize) {pos.y-=blockSize;}
    if (pos.z < 0) {pos.z+=blockSize;} else if (pos.z >= blockSize) {pos.z-=blockSize;}
    return sampleAtlas(pos.x, pos.y, pos.z, blockType, blockSubtype);
}
vec4 noise(vec2 coords) {
    return (textureLod(Sampler2D[nonuniformEXT(pushUbo.noises)], vec2(coords/1024), 0)*2)-1.f;
}
vec4 noiseInv(vec2 coords) {
    return ((1-textureLod(Sampler2D[nonuniformEXT(pushUbo.noises)], vec2(coords/1024), 0))*2)-1.f;
}
vec4 getCaustic(float speed, vec2 checkPos) {
    float time = globalUbo.time*speed;
    return noise((checkPos*32)+time);
}
const int materialWidth = 16;
const int materialSetWidth = materialWidth*3;
const int materialHeight = materialWidth*6;
const int materialAtlasWidth = 2304;
const int materialsPerRow = materialAtlasWidth/materialSetWidth;
vec4 getCausticSmall(bool animated, vec2 checkPos) {
    float time = animated ? globalUbo.time/50.f : 0.f;
    vec3 model = sampleAtlas(4, 4, 4, 1, 15).rgb;
    int materialId = int(int(round(model.r*255)) | (int(round(model.g*255)) << 8) | (int(round(model.b*255)) << 16));
    int materialY = int(materialId/materialsPerRow);
    materialId-=(materialY*materialsPerRow);
    ivec2 localTexel = ivec2(floor(fract(checkPos)*float(materialWidth)));
    localTexel = clamp(localTexel, ivec2(0), ivec2(materialWidth-1));
    localTexel.y = int(mod(localTexel.y+time, materialWidth));
    vec4 small = texelFetch(Sampler2D[nonuniformEXT(pushUbo.materials)], ivec2(ivec2(materialId*materialWidth*2, materialY*materialHeight)+localTexel), 0);
    small.a = max(small.r, max(small.g, small.b));
    small.rgb = texelFetch(Sampler2D[nonuniformEXT(pushUbo.materials)], ivec2(ivec2((materialId*materialWidth*2)+materialWidth, materialY*materialHeight)+localTexel), 0).rgb*0.4f;
    return small;
}
vec4 getCausticThrice(bool animated, vec2 checkPos, float dist) {
    float speed = animated ? 0.00333f : 0.f;
    vec4 large = (mix(getCaustic(speed, floor(checkPos)), getCaustic(speed, floor(checkPos*0.25f)), min(1, dist*2))-0.5f)*max(0.1f, sqrt(0.5f-dist));
    return mix(max(getCausticSmall(animated, checkPos), vec4(0, 0, 0, large.a)), large, pow(clamp((dist-0.025f)*10, 0, 1), 0.67f));
    //    return mix(max(pow(getCaustic(animated, (checkPos*24)+time), vec4(1.f, 1.f, 1.f, 2.5f))*vec4(1.5f, 1.5f, 1.5f, 4.f), large), large, pow(clamp((dist-0.025f)*10, 0, 1), 0.67f)-0.1f);
}
vec4 getCausticInv(float speed, vec2 checkPos) {
    float time = globalUbo.time*speed;
    return noiseInv((checkPos*32)+time);
}
