struct MaterialStruct {
    vec4 albedo;
    vec4 norm;
    vec4 fx;
};
MaterialStruct getMaterial(int materialId, vec3 pos, vec3 norm, bool animated) {
    vec3 unoffsetHitPos = pos-(norm*0.0006f);
    vec3 floatingHitPos = unoffsetHitPos-floor(unoffsetHitPos);
    vec3 absNorm = abs(norm);
    vec2 matUV = floatingHitPos.xz;//(absNorm.x > absNorm.y && absNorm.x > absNorm.z) ? floatingHitPos.yz : ((absNorm.y > absNorm.x && absNorm.y > absNorm.z) ? floatingHitPos.xz : floatingHitPos.xy);
    int yOff = 0; //top
    vec2 dir = vec2(rayDir.xz);
    if (norm.y < norm.x && norm.y < norm.z) { //bottom
        yOff = materialHeight-materialWidth;
        matUV = floatingHitPos.zx;
    } else if (!(norm.y > norm.x && norm.y > norm.z)) { //side
        vec3 floatingUV = floatingHitPos;
        floatingUV.y = 1-floatingUV.y;
        if (absNorm.x > absNorm.z) {
            dir = rayDir.zy;
            matUV = floatingUV.zy;
            if (norm.x < 0) { matUV.x = 1-matUV.x; }
            yOff = norm.x > 0 ? materialWidth : materialWidth*3;
        } else {
            dir = rayDir.xy;
            matUV = floatingUV.xy;
            if (norm.z > 0) { matUV.x = 1-matUV.x; }
            yOff = norm.z > 0 ? materialWidth*2 : materialWidth*4;
        }
    }
    int materialY = int(materialId/materialsPerRow);
    materialId-=(materialY*materialsPerRow);
    ivec2 localTexel = ivec2(floor(matUV*float(materialWidth)));
    if (animated) {
        localTexel.y = int(mod(localTexel.y - (globalUbo.time / 50.f), materialWidth));
    }
    localTexel = clamp(localTexel, ivec2(0), ivec2(materialWidth-1));
    vec4 materialColor = texelFetch(Sampler2D[nonuniformEXT(pushUbo.materials)], ivec2(ivec2(materialId*materialWidth*3, (materialY*materialHeight)+yOff)+localTexel), 0);
    vec4 materialNorm = texelFetch(Sampler2D[nonuniformEXT(pushUbo.materials)], ivec2(ivec2((materialId*materialWidth*3)+materialWidth, (materialY*materialHeight)+yOff)+localTexel), 0);
    vec4 materialFx = texelFetch(Sampler2D[nonuniformEXT(pushUbo.materials)], ivec2(ivec2((materialId*materialWidth*3)+(materialWidth*2), (materialY*materialHeight)+yOff)+localTexel), 0);
    materialNorm.xyz = (materialNorm.xyz*2)-1;

//    if (max(materialColor.r, max(materialColor.g, materialColor.b)) < 0.55f) {
//        localTexel = ivec2(mod((matUV*float(materialWidth))+(dir*2), materialWidth));
//        materialColor = texelFetch(Sampler2D[nonuniformEXT(pushUbo.materials)], ivec2(ivec2(materialId*materialWidth, (materialY*materialHeight)+yOff)+localTexel), 0);
//        float pomDepth = clamp(length(dir)*0.5f, 0, 0.9f);
//        if (max(materialColor.r, max(materialColor.g, materialColor.b)) >= 0.55f) {
//            materialColor.rgb *= 1 - pomDepth;
//        }
//        materialColor.rgb *= 0.95f;
//    }
    return MaterialStruct(materialColor, materialNorm, materialFx);
}
MaterialStruct getMaterial(vec4 model, vec3 pos, vec3 norm, bool animated) {
    return getMaterial(int(int(round(model.r*255)) | (int(round(model.g*255)) << 8) | (int(round(model.b*255)) << 16)), pos, norm, animated);
}
vec3 firstTintAddition = vec3(0);
vec4 prevTintAddition = vec4(0);
vec4 tint = vec4(1);
vec3 tintNormal = vec3(0);
MaterialStruct tintMaterial = MaterialStruct(vec4(0), vec4(0), vec4(0));
void addTint(vec4 voxelColor, vec3 thisNormal, bool shadow) {
    MaterialStruct material = getMaterial(voxelColor, hitPos, thisNormal, false);
    voxelColor.rgb = material.albedo.rgb;
    if (tintNormal == vec3(0)) {
        tintMaterial = material;
        tintNormal = thisNormal;
        vec3 materialNorm = material.norm.xyz*vec3(material.fx.x, material.fx.x, 1);
        vec3 tangent = (abs(tintNormal.y) > 0.999) ? vec3(1.0, 0.0, 0.0) : normalize(cross(vec3(0.0, 1.0, 0.0), tintNormal));
        tintNormal.xyz = normalize(tangent * materialNorm.x + cross(tintNormal, tangent) * materialNorm.y + tintNormal * materialNorm.z);
    }
    if (prevTintAddition != voxelColor) {
        float brightness = dot((tint.a < 1 ? -1 : 1) * thisNormal, globalUbo.skylight.xyz)*-0.0001f;
        float tintMul = clamp(0.875f+brightness, 0.75f, 1.f);
        prevTintAddition = voxelColor;
        if (firstTintAddition == vec3(0)) {
            firstTintAddition = voxelColor.rgb*tintMul;
        }
        vec3 shadeTintFactor = (shadow ? vec3(1-voxelColor.r, 1-voxelColor.g, 1-voxelColor.b)*(tint.a == 1 ? 1.5f : 1.f) : vec3(1));
        tint.rgb -= shadeTintFactor * abs(1-voxelColor.rgb)*tintMul*tint.rgb;
        tint.a -= max(shadeTintFactor.r, max(shadeTintFactor.g, shadeTintFactor.b)) * voxelColor.a*tint.a;
    }
}

bool isGlass(int block) {return block == 11 || block == 12 || block == 13 || block == 66 || block == 67;}

vec3 normal = vec3(0);
ivec3 firstVoxelRayPos = ivec3(0);
ivec3 firstBlockPos = ivec3(0);
vec3 firstHitPos = vec3(0);
ivec2 firstBlock = ivec2(0);
vec3 firstNormal = vec3(0);
vec3 ogChunkPos = vec3(0);
vec3 raySign = vec3(0);
ivec2 block = ivec2(0);
LongStruct lod = LongStruct(0, 0);
vec4 dda(bool shadow) {
    rayDirDivved = 1.f/rayDir;
    ogRayPos = rayPos;
    ogRayDir = rayDir;
    raySign = sign(rayDir);
    int stage = 3;

    LongStruct region = LongStruct(0, 0);

    vec3 chunkStartPos = rayPos/chunkSize;
    ivec3 chunkPos = ivec3(floor(chunkStartPos));
    ivec3 ddaPos = chunkPos;
    vec3 dist = 1.0/rayDir;
    vec3 sideDist = ((ddaPos - chunkStartPos) + 0.5 + raySign * 0.5) * dist;
    vec3 chunkSideDist = sideDist;
    stepMask(sideDist);
    ivec3 chunkWorldPos = ivec3(0);

    vec3 lodStartPos = vec3(0);
    ivec3 lodRayPos = ivec3(0);
    vec3 lodPos = vec3(0);
    ivec3 lodWorldPos = ivec3(0);

    vec3 blockStartPos = vec3(0);
    ivec3 blockRayPos = ivec3(0);

    vec3 voxelStartPos = vec3(0);
    vec3 voxelPos = vec3(0);
    //int steps = 0;
    while (true) {
        //steps++;
        bool stepAnything = true;
        if (stage == 3) {
            if (ddaPos.x < 0 || ddaPos.x >= sizeChunks || ddaPos.y < 0 || ddaPos.y >= heightChunks || ddaPos.z < 0 || ddaPos.z >= sizeChunks) {break;}
            updateChunkData(ddaPos);
            if (chunk.bitsPerValue != 0) { //temporary if statement until regions re-added
                stage = 2;
                stepAnything = false;
                chunkPos = ddaPos;
                chunkSideDist = sideDist;

                chunkWorldPos = ddaPos * chunkSize;
                lodStartPos = uv3d(chunkWorldPos, float(chunkSize), lodSize);
                ddaPos = ivec3(lodStartPos);
                sideDist = ((ddaPos - lodStartPos) + 0.5 + raySign * 0.5) * dist;
            }
        } else if (stage == 2) {
            if (ddaPos.x < 0 || ddaPos.x >= lodSize || ddaPos.y < 0 || ddaPos.y >= lodSize || ddaPos.z < 0 || ddaPos.z >= lodSize) {
                stage = 3;
                ddaPos = chunkPos;
                sideDist = chunkSideDist;
            } else {
                lodPos = chunkWorldPos/lodSize+ddaPos;
                lod = chunk.bitsPerValue < 1 ? LongStruct(-1, -1) : getLod(ddaPos);
                if (lod != LongStruct(0, 0)) {
                    stage = 1;
                    stepAnything = false;
                    lodRayPos = ddaPos;

                    lodWorldPos = ivec3(lodPos*lodSize);
                    blockStartPos = uv3d(lodWorldPos, float(lodSize), lodSize);
                    ddaPos = ivec3(blockStartPos);
                    sideDist = ((ddaPos - blockStartPos) + 0.5 + raySign * 0.5) * dist;
                }
            }
        } else if (stage == 1) {
            if (ddaPos.x < 0 || ddaPos.x >= lodSize || ddaPos.y < 0 || ddaPos.y >= lodSize || ddaPos.z < 0 || ddaPos.z >= lodSize) {
                stage = 2;
                ddaPos = lodRayPos;
                sideDist = ((ddaPos - lodStartPos) + 0.5 + raySign * 0.5) * dist;
            } else {
                int bitIdx = (ddaPos.x & (lodSize-1)) + (ddaPos.y & (lodSize-1)) * lodSize + (ddaPos.z & (lodSize-1)) * lodSize * lodSize;
                int lodToUse = lod.first;
                if (bitIdx >= 32) {
                    bitIdx-=32;
                    lodToUse = lod.second;
                }
                int mask = 1 << bitIdx;
                if ((lodToUse & mask) != 0) {
                    blockPos = lodWorldPos+ddaPos;
                    block = getBlock(blockPos);
                    voxelStartPos = uv3d(blockPos, 1.f, blockSize);
                    //if (shadow && block.x == 4) {block.x = 0;}
                    vec4 voxelColor = sampleAtlas(int(voxelStartPos.x), int(voxelStartPos.y), int(voxelStartPos.z), block.x, block.y);
                    if (voxelColor.a > 0) {
                        flatNormal = -ddaMask * raySign;
                        normal = flatNormal;
                        hitPos = blockPos + (voxelStartPos * voxelSize) + (flatNormal*0.01f);
                        voxelPos = hitPos;
                        if (firstBlock.x == 0) {
                            firstBlockPos = blockPos;
                            firstVoxelRayPos = ivec3(voxelStartPos);
                            firstBlock = block;
                            firstHitPos = hitPos;
                            firstNormal = normal;
                        }
                        if (voxelColor.a > alphaMax) {
                            shadowPos = hitPos;
                            return voxelColor;
                        } else {
                            addTint(voxelColor, normal, shadow);
                        }
                    } else {
                        stage = 0;
                        stepAnything = false;
                        blockRayPos = ddaPos;

                        ddaPos = ivec3(voxelStartPos);
                        sideDist = ((ddaPos - voxelStartPos) + 0.5 + raySign * 0.5) * dist;
                    }
                }
            }
        } else if (stage == 0) {
            if (ddaPos.x < 0 || ddaPos.x >= blockSize || ddaPos.y < 0 || ddaPos.y >= blockSize || ddaPos.z < 0 || ddaPos.z >= blockSize) {
                stage = 1;
                ddaPos = blockRayPos;
                sideDist = ((ddaPos - blockStartPos) + 0.5 + raySign * 0.5) * dist;
            } else {
                vec4 voxelColor = sampleAtlas(ddaPos.x, ddaPos.y, ddaPos.z, block.x, block.y);
                if (voxelColor.a > 0) {
                    flatNormal = -ddaMask*raySign;
                    normal = flatNormal;
                    voxelPos = blockPos+(ddaPos*voxelSize);
                    vec3 subvoxelPos = (uv3d(voxelPos, voxelSize, blockSize)/blockSize)*voxelSize;
                    voxelPos += flatNormal*0.01f;
                    hitPos = voxelPos+(subvoxelPos);
                    if (firstBlock.x == 0) {
                        firstVoxelRayPos = ivec3(floor(voxelPos*blockSize));
                        firstBlock = block;
                        firstHitPos = hitPos;
                        firstNormal = normal;
                    }
                    if (voxelColor.a > alphaMax) {
                        shadowPos = hitPos;
                        return voxelColor;
                    } else {
                        addTint(voxelColor, normal, shadow);
                        stage = 1;
                        ddaPos = blockRayPos;
                        sideDist = ((ddaPos - blockStartPos) + 0.5 + raySign * 0.5) * dist;
                    }
                }
            }
        }
        if (stepAnything) { //dont step if it just went to a finer detail
            stepMask(sideDist);
            sideDist += ddaMask * raySign * dist;
            ddaPos += ivec3(ddaMask * raySign);
        }
    }
    return vec4(0);
}

vec3 frensel(float ang, vec3 reflectivity) {
    return reflectivity+(vec3(1)-reflectivity)*pow(1-ang, 5);
}
vec3 scatterVec(vec3 vec) {
    vec = fract(vec * 0.1031);
    vec += dot(vec, vec + 33.33);
    return fract((vec.xxy + vec.yzz) * vec.zyx);
}
vec3 mipmap(vec3 color) {
    vec3 localPos = unzeroVec(abs(fract(hitPos)-vec3(0, 1, 0)));
    voxelRayPos = ivec3(localPos*blockSize);
    int inc = 3;
    vec3 subbed = vec3(dot(-flatNormal.x, rayDir.x), dot(-flatNormal.y, rayDir.y), dot(-flatNormal.z, rayDir.z));
    bool xHighest = subbed.x > subbed.y && subbed.x > subbed.z;
    bool yHighest = subbed.y > subbed.x && subbed.y > subbed.z;
    bool zHighest = subbed.z > subbed.x && subbed.z > subbed.y;
    vec3 avgNColor = vec3(0);
    float maxBrightness = 0;
    float neighborsSolid = 0.f;
    for (int x = xHighest ? voxelRayPos.x : voxelRayPos.x-inc; x <= voxelRayPos.x+inc; x+= xHighest ? 100 : inc) {
        for (int y = yHighest ? voxelRayPos.y : voxelRayPos.y-inc; y <= voxelRayPos.y+inc; y+= yHighest ? 100 : inc) {
            for (int z = zHighest ? voxelRayPos.z : voxelRayPos.z-inc; z <= voxelRayPos.z+inc; z+= zHighest ? 100 : inc) {
                vec4 neighbor = sampleAtlasTiled(x, y, z, block.x, block.y);
                if (neighbor.a > alphaMax) {
                    neighbor.rgb = getMaterial(neighbor, hitPos, flatNormal, false).albedo.rgb;
                    float brightness = max(neighbor.r, max(neighbor.g, neighbor.b));
                    maxBrightness = max(maxBrightness, brightness);
                    avgNColor += (neighbor.rgb)*brightness;
                    neighborsSolid+=1*brightness;
                }
            }
        }
    }
    if (neighborsSolid > 0) {
        avgNColor /= neighborsSolid;
        float dist = min(1, distance(ogPos, blockPos+(voxelRayPos/float(blockSize)))/100);
        color = mix(color, avgNColor, dist);//clamp(mix(color, avgNColor, clamp(dist-max(0, 4*(max(color.r, max(color.g, color.b))-0.5f)), 0, 1)), 0, 1);
    }
    return color;
}
float fogDist = pow(globalUbo.fogginess, 4);
float getFogginess(bool isSky, vec3 pos, float mul, float maxFog) {
    return globalUbo.fogginess <= 0 ? 0 : (isSky ? maxFog : clamp((sqrt(max(abs(ogPos.x-pos.x), max(abs(ogPos.y-pos.y), abs(ogPos.z-pos.z))) / (renderDistance * fogDist))-0.25f) * (gradient(pos.y, SEA_LEVEL, SEA_LEVEL+32, 0, max(0, (noiseInv(pos.xz).w+0.5f)*0.5f))+gradient(pos.y, SEA_LEVEL+32, SEA_LEVEL+320, 0.75f, 1)) * mul, 0.f, maxFog));
}
vec3 hueShift(vec3 color, float hue) {
    const vec3 k = vec3(0.57735, 0.57735, 0.57735);
    float cosAngle = cos(hue);
    return vec3(color * cosAngle + cross(k, color) * sin(hue) + k * dot(k, color) * (1.0 - cosAngle));
}
vec3 hueMix(vec3 color, float hue, float factor) {
    const vec3 chromaU = normalize(vec3(2.f, -1.f, -1.f));
    const vec3 chromaV = normalize(vec3(0.f, 1.f, -1.f));
    vec2 chroma = vec2(dot(color, chromaU), dot(color, chromaV));
    vec2 target = vec2(cos(hue), sin(hue));
    float hueDelta = atan(chroma.x * target.y - chroma.y * target.x, dot(chroma, target) + 1e-6);
    float angle = hueDelta * clamp(factor * hueDelta * hueDelta / (PI * PI), 0.0, 1.0) * smoothstep(0.0, 0.03, length(chroma));
    vec2 shifted = (mat2(cos(angle), sin(angle), -sin(angle), cos(angle)) * chroma)-chroma;
    return color + shifted.x * chromaU + shifted.y * chromaV;
}
const int swizzle = 16;
const int localSize = 8;
const int localSizeSub1 = localSize-1;
layout (local_size_x = 8, local_size_y = 8, local_size_z = 1) in;
void main() {
    ivec2 res = globalUbo.renderToggles.z == 1 ? ivec2(globalUbo.res/2.f) : globalUbo.res;
    int group = int(gl_WorkGroupID.x);
    int groupsPerTile = swizzle * ((res.y + localSizeSub1) / localSize);
