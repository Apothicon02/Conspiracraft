void updateLightChunkData(ivec3 chunkPos) {
    int condensedChunkPos = (((chunkPos.x*sizeChunks)+chunkPos.z)*heightChunks)+chunkPos.y;
    if (condensedChunkPos >= 0 && condensedChunkPos < lightchunkBufLength) {
        lightChunk = chunkBuf[nonuniformEXT(pushUbo.lightChunks)].data[condensedChunkPos];
        lightValuesPerInt = lightChunk.bitsPerValue <= 0 ? lightChunk.bitsPerValue : 32 / lightChunk.bitsPerValue;
    }
}
